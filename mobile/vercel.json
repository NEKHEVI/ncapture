{
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["yul1"],
  "redirects": [
    { "source": "/", "destination": "/capture", "permanent": false },
    { "source": "/rbooks", "destination": "/nbooks", "permanent": true },
    { "source": "/source", "destination": "https://github.com/NEKHEVI/ncapture", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
    ] },
    { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ],
  "functions": { "api/lire.js": { "maxDuration": 60 } }
}
